# Database (SQLite default for local/Vercel zero-friction, or PostgreSQL / Supabase connection string)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Generate a strong 32+ character random secret for production)
JWT_SECRET="replace_with_a_secure_random_string_in_production"

# Initial Admin Credentials (change password after first login in /admin/settings)
ADMIN_EMAIL="admin@anantyadav.com"
ADMIN_PASSWORD="YourSecurePasswordHere"

# Production Site URL
NEXT_PUBLIC_SITE_URL="https://authoranantyadav.vercel.app"

# Optional: Google Analytics & Search Console
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GSC_TOKEN="your_google_site_verification_token"
