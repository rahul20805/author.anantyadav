# Database (SQLite default for local/Vercel zero-friction, or PostgreSQL / Supabase connection string)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Generate a strong 32+ character random secret for production)
JWT_SECRET="replace_with_a_secure_random_string_in_production"

# Initial Admin Credentials (change password after first login in /admin/settings)
ADMIN_EMAIL="admin@anantyadav.com"
ADMIN_PASSWORD="YourSecurePasswordHere"

# Production Site URL
NEXT_PUBLIC_SITE_URL="https://authoranant.in"

# Google Analytics & Search Console (Add your IDs here or in Vercel Environment Variables)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GSC_TOKEN="google-site-verification=your_verification_token"

# =========================================================================
# BREVO EMAIL AUTOMATION (Free Tier: 300 emails/day with custom sender)
# =========================================================================
# 1. PRIMARY & RECOMMENDED: Brevo v3 REST API (Zero port block, instant dispatch)
#    Get API key from: Brevo Dashboard -> SMTP & API -> API Keys -> Generate Key
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"

# 2. BREVO AUTOMATION WORKFLOWS (Optional)
#    Enter your Brevo List ID (e.g. 2) to automatically sync subscribers into a list
#    This lets you trigger automated email series & follow-ups inside Brevo!
# BREVO_LIST_ID="2"

# 3. SENDER IDENTITY
BREVO_SENDER_NAME="Anant Yadav"
BREVO_SENDER_EMAIL="newsletter@author.in"

# 4. FALLBACK: Brevo SMTP Relay (Used if BREVO_API_KEY is omitted)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login@email.com"
SMTP_PASS="your-brevo-smtp-key"
SMTP_SECURE="false"
EMAIL_FROM="Anant Yadav <newsletter@author.in>"
